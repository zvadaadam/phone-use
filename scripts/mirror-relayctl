#!/bin/zsh
set -euo pipefail

SCRIPT_DIR="${0:A:h}"
PROJECT_DIR="${SCRIPT_DIR:h}"
INSTALLED_CLI="/Applications/Mirror Relay.app/Contents/Helpers/mirror-relay"
LOCAL_CLI="${PROJECT_DIR}/dist/Mirror Relay.app/Contents/Helpers/mirror-relay"
LEGACY_INSTALLED_CLI="/Applications/Mirror Relay.app/Contents/Resources/bin/mirror-relayctl"

if [[ -x "${INSTALLED_CLI}" ]]; then
  exec "${INSTALLED_CLI}" "$@"
fi
if [[ -x "${LOCAL_CLI}" ]]; then
  exec "${LOCAL_CLI}" "$@"
fi
if [[ -x "${LEGACY_INSTALLED_CLI}" ]]; then
  exec "${LEGACY_INSTALLED_CLI}" "$@"
fi

print -u2 "Mirror Relay is not packaged. Run: npm run package:app"
exit 1
